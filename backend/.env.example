PROJECT_NAME="AI Presentation Coach"
API_V1_STR="/api"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Limits
MAX_SLIDE_SIZE_MB=20
MAX_MEDIA_SIZE_MB=50
MAX_MEDIA_DURATION_SECONDS=900

# AI Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
OPENAI_EVALUATION_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
AI_PROVIDER="gemini"
